# Copy to .env and edit. Empty values keep what is in server-data/server.yml.
SERVER_NAME=Avledet server
SERVER_PASSWORD=
# true shows the server in the community list
SERVER_PUBLIC=false
MAX_PLAYERS=10
# world name and save folder name in server-data/worlds_local/
WORLD_NAME=world
# seed of a new world, empty means random
WORLD_SEED=

# owner of game-data/ and server-data/ on the host: id -u, id -g
PUID=1000
PGID=1000
